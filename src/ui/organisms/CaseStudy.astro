---
import StatusTag from '../atoms/StatusTag.astro';
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  tags: string[];
  sourceLabel?: string;
  sourceHref?: string;
  evidenceLabel?: string;
  imageFit?: 'cover' | 'contain';
}
const { eyebrow, title, summary, image, imageAlt, tags, sourceLabel, sourceHref, evidenceLabel = 'REAL UI · synthetic/public data only', imageFit = 'cover' } = Astro.props;
---
<article class="case-study">
  <header class="case-hero">
    <div><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="case-summary">{summary}</p><div class="tag-row">{tags.map((tag) => <StatusTag label={tag} />)}</div></div>
    <figure class="evidence-frame"><img src={image} alt={imageAlt} width="1200" height="750" fetchpriority="high" style={`object-fit:${imageFit}`} /><figcaption>{evidenceLabel}</figcaption></figure>
  </header>
  <div class="case-body"><slot /></div>
  {sourceHref && <a class="source-link" href={sourceHref}>{sourceLabel ?? '저장소 보기'} <span>↗</span></a>}
</article>
